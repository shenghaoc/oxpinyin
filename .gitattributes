# Fixtures in this repository are byte-exact artefacts, and two gates depend
# on their exact bytes: capture records are stamped with a SHA-256, and a
# golden line is scanned for stray control bytes.
#
# Git on Windows rewrites LF to CRLF on checkout by default, which breaks
# both — a committed "a" arrives as "a\r". Normalise to LF everywhere, and
# mark the byte-exact data as not text at all so nothing can translate it.
* text=auto eol=lf

fixtures/** -text
fuzz/corpus/** -text

# proptest writes these itself and recommends committing them: the seeds are
# re-run before any novel case, so a bug a property found stays found.
# Generated, not authored — collapse them in diffs and keep them out of
# language stats.
**/proptest-regressions/** linguist-generated
