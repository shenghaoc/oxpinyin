# Generated by Cargo
debug
/target
/.oxpinyin-container/
# /target includes the model20 fetch cache (just fetch-model).
# The archive, its extraction, and any converted form must never be tracked.
/fuzz/target/
/fuzz/artifacts/
/fuzz/coverage/
# Ignore generated corpus noise; keep committed seeds under parser/ and
# session-keys/ addable without `git add -f` (cannot re-include under an
# ignored parent directory).
/fuzz/corpus/*
!/fuzz/corpus/parser/
!/fuzz/corpus/parser/**
!/fuzz/corpus/session-keys/
!/fuzz/corpus/session-keys/**

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# Kiro settings (local, not committed)
/.kiro/settings/cli.json
/.kiro/settings/lsp.json

# Local agent tooling worktrees (not committed)
/.claude/

# Bisection harness compiled binaries (the runners compile bisect beside the
# source; one was committed by mistake until 2026-09-06)
/tools/bisection/*-bin
/tools/bisection/bisect

# macOS
.DS_Store

# Python tooling sidecars (tools/**/*.py; no in-tree binding)
.venv*/
__pycache__/
*.py[cod]

# Container drop-in gates write their cargo targets here (run-dropin-*.sh).
/target-fedora/
/target-debian/
/target-nixos/

# Profiling passes build the same crate under alternate debug/LTO/frame-pointer
# settings into their own CARGO_TARGET_DIRs, so the shipped artifact's target
# dir is never invalidated.
/target-dbg/
/target-fp/

# Measurement captures are disposable local working data. Reports give final
# results and reproduction commands (CONTRIBUTING.md). These patterns prevent
# accidental commits; captures are not routine attachments or upload tasks.
/tools/bisection/*.out
/tools/bisection/massif.*
/tools/bisection/dhat.*
*-smaps-init.txt
*-smaps-cycle.txt
*-smaps-trim.txt
*-smaps-rollup-*.txt
*-maps-init.txt
*-maps-cycle.txt
*-maps-trim.txt
*-mallocinfo.xml
callgrind.out.*
dhat.out.*
massif.out.*
perf.data*
