+/* Diagnostic only: inspect the unmodified algorithm input in pin arithmetic.
+ * The caller supplies a case identity; no pointers or host paths are printed. */
+static void dump_precondition_value(const char *label, guint position,
+                                    const trellis_value_t *value) {
+    fprintf(stderr, "\t%s_position=%u\t%s_length=%d\t%s_poss=%a"
+            "\t%s_prev=0x%08x\t%s_token=0x%08x\t%s_slot=%d",
+            label, position, label, value->m_sentence_length,
+            label, (double)value->m_poss, label, value->m_handles[0],
+            label, value->m_handles[1], label, value->m_current_index);
+}
+
+template <gint32 nstore>
+static void dump_precondition_pairs(const char *site, gint32 step,
+                                     const GPtrArray *candidates) {
+    const char *case_id = getenv("OXPINYIN_PRECONDITION_CASE");
+    if (NULL == case_id || 2 != nstore)
+        return;
+    size_t violations = 0;
+    guint first_a = 0, first_b = 0;
+    bool first_ab = false, first_ba = false;
+    for (guint a = 0; a < candidates->len; ++a) {
+        const trellis_value_t *lhs = (const trellis_value_t *)candidates->pdata[a];
+        for (guint b = a + 1; b < candidates->len; ++b) {
+            const trellis_value_t *rhs = (const trellis_value_t *)candidates->pdata[b];
+            const bool ab = trellis_value_less_than<nstore>(lhs, rhs);
+            const bool ba = trellis_value_less_than<nstore>(rhs, lhs);
+            if (ab && ba) {
+                if (0 == violations) {
+                    first_a = a; first_b = b;
+                    first_ab = ab; first_ba = ba;
+                }
+                ++violations;
+            }
+        }
+    }
+    fprintf(stderr, "precondition\tcase=%s\tsite=%s\tstep=%d\tcount=%u"
+            "\tpairs=%zu\twitness=%d", case_id, site, step, candidates->len,
+            violations, violations != 0);
+    if (violations) {
+        dump_precondition_value("a", first_a,
+            (const trellis_value_t *)candidates->pdata[first_a]);
+        dump_precondition_value("b", first_b,
+            (const trellis_value_t *)candidates->pdata[first_b]);
+        fprintf(stderr, "\tless_ab=%d\tless_ba=%d", first_ab, first_ba);
+    }
+    fprintf(stderr, "\n");
+}
+
+static void dump_precondition_tails(gint32 step, const GPtrArray *tails) {
+    const char *case_id = getenv("OXPINYIN_PRECONDITION_CASE");
+    if (NULL == case_id)
+        return;
+    fprintf(stderr, "precondition\tcase=%s\tsite=S3\tstep=%d\tcount=%u",
+            case_id, step, tails->len);
+    for (guint a = 0; a < tails->len; ++a) {
+        const trellis_value_t *lhs = (const trellis_value_t *)tails->pdata[a];
+        for (guint b = 0; b < tails->len; ++b) {
+            if (a == b)
+                continue;
+            const trellis_value_t *mid = (const trellis_value_t *)tails->pdata[b];
+            for (guint c = a + 1; c < tails->len; ++c) {
+                if (b == c)
+                    continue;
+                const trellis_value_t *rhs = (const trellis_value_t *)tails->pdata[c];
+                /* Out-of-range lambda/NaN is outside this finite witness set.
+                 * Do not introduce a float-to-gint UB probe in the diagnostic. */
+                if (!isfinite(lhs->m_poss) || !isfinite(mid->m_poss) ||
+                    !isfinite(rhs->m_poss) ||
+                    fabs((double)lhs->m_poss - mid->m_poss) >= G_MAXINT ||
+                    fabs((double)mid->m_poss - rhs->m_poss) >= G_MAXINT ||
+                    fabs((double)lhs->m_poss - rhs->m_poss) >= G_MAXINT)
+                    continue;
+                const gint ab = trellis_value_compare(&lhs, &mid);
+                const gint ba = trellis_value_compare(&mid, &lhs);
+                const gint bc = trellis_value_compare(&mid, &rhs);
+                const gint cb = trellis_value_compare(&rhs, &mid);
+                const gint ac = trellis_value_compare(&lhs, &rhs);
+                const gint ca = trellis_value_compare(&rhs, &lhs);
+                if (0 == ab && 0 == ba && 0 == bc && 0 == cb && ac != 0 && ca != 0) {
+                    fprintf(stderr, "\twitness=1");
+                    dump_precondition_value("a", a, lhs);
+                    dump_precondition_value("b", b, mid);
+                    dump_precondition_value("c", c, rhs);
+                    fprintf(stderr, "\tcompare_ab=%d\tcompare_ba=%d"
+                            "\tcompare_bc=%d\tcompare_cb=%d"
+                            "\tcompare_ac=%d\tcompare_ca=%d\n",
+                            ab, ba, bc, cb, ac, ca);
+                    return;
+                }
+            }
+        }
+    }
+    fprintf(stderr, "\twitness=0\n");
+}
