# Generated by Cargo
debug
/target
# /target includes the model20 fetch cache (tools/model/fetch-model.sh).
# The archive, its extraction, and any converted form must never be tracked.
/fuzz/target/
/fuzz/artifacts/
/fuzz/coverage/
# Ignore generated corpus noise; keep committed seeds under parser/ addable
# without `git add -f` (cannot re-include under an ignored parent directory).
/fuzz/corpus/*
!/fuzz/corpus/parser/
!/fuzz/corpus/parser/**

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# Kiro settings (local, not committed)
/.kiro/settings/cli.json
/.kiro/settings/lsp.json

# Local agent tooling worktrees (not committed)
/.claude/

# Bisection harness compiled binaries (every run-*.sh compiles its driver
# beside the source; one was committed by mistake until 2026-09-06)
/tools/bisection/*-bin
/tools/bisection/bisect
/tools/bisection/train-diff
/tools/bisection/nbest-train-diff
/tools/bisection/live-typing-diff
/tools/bisection/import-diff
/tools/bisection/frontend-import
/tools/bisection/scheme-diff
/tools/bisection/chewing-diff
/tools/bisection/user-candidate-diff
/tools/bisection/addon-candidate-diff
/tools/bisection/predict-diff
/tools/bisection/punct-diff
/tools/bisection/union-diff
/tools/bisection/union-edge-diff
/tools/bisection/plant-oracle-bigram

# macOS
.DS_Store

# The user-learning store is per-user runtime data; it must never be
# committed (W6-T5: no user-data fixtures beyond tiny synthetic ones).
user_store.redb
tools/bisection/fullpin-diff
/tools/bisection/uncovered-surface-diff
/tools/bisection/pred-order-diff

# Python development (crates/oxpinyin-python)
.venv*/
__pycache__/
*.py[cod]

# maturin editable-install artifacts land the extension next to python-source
/crates/oxpinyin-python/python/oxpinyin/*.so
/crates/oxpinyin-python/python/oxpinyin/*.pyd

# LMDB rewrites a runtime lock file beside each .lmdb fixture on every
# open, read-only included; the data files never change. The sidecars
# live one level down (fixtures/w3/lmdb/*.lmdb-lock), so the pattern is
# recursive. Six were tracked until 2026-09-06 because an earlier
# pattern matched only the top level.
/fixtures/**/*.lmdb-lock

# oxpinyin-datagen (since the 1-gram-only emission) writes an
# interpolation2.text into every --out-dir; the committed w3 fixture sets
# predate that and deliberately do not carry it — nothing at runtime reads
# it from a data dir.
/fixtures/w3/*/interpolation2.text

# Container drop-in gates write their cargo targets here (run-dropin-*.sh).
/target-fedora/
/target-debian/
/target-nixos/

# Profiling passes build the same crate under alternate debug/LTO/frame-pointer
# settings into their own CARGO_TARGET_DIRs, so the shipped artifact's target
# dir is never invalidated (docs/runbooks/benches.md, "RSS diagnosis").
/target-dbg/
/target-fp/

# Capture output from the measurement harnesses. Findings documents commit
# no captures: they record the command that produced each figure, and bulk
# evidence is attached to the PR (docs/runbooks/benches.md). These patterns
# exist so a stray capture cannot be swept in by `git add -A`.
/tools/bisection/*.out
/tools/bisection/massif.*
/tools/bisection/dhat.*
*-smaps-init.txt
*-smaps-cycle.txt
*-smaps-trim.txt
*-smaps-rollup-*.txt
*-maps-init.txt
*-maps-cycle.txt
*-maps-trim.txt
*-mallocinfo.xml
callgrind.out.*
dhat.out.*
massif.out.*
perf.data*
