{
  "name": "tkrzw",
  "version": "1.0.34",
  "description": "Thread-safe DBM library",
  "homepage": "https://dbmx.net/tkrzw/",
  "license": "Apache-2.0",
  "supports": "(windows & !uwp & !mingw) | osx | linux",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true,
      "platform": "windows"
    },
    {
      "name": "vcpkg-make",
      "host": true,
      "platform": "osx | linux"
    }
  ],
  "features": {
    "lz4": {
      "description": "LZ4 compression support",
      "supports": "windows",
      "dependencies": [
        "lz4"
      ]
    },
    "lzma": {
      "description": "LZMA compression support",
      "supports": "windows",
      "dependencies": [
        "liblzma"
      ]
    },
    "zlib": {
      "description": "zlib compression support",
      "supports": "windows",
      "dependencies": [
        "zlib"
      ]
    },
    "zstd": {
      "description": "Zstandard compression support",
      "supports": "windows",
      "dependencies": [
        "zstd"
      ]
    }
  }
}
