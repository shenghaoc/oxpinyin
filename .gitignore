# Generated by Cargo
debug
/target
# /target includes the model20 fetch cache (tools/model/fetch-model.sh).
# The archive, its extraction, and any converted form must never be tracked.
/fuzz/target/
/fuzz/artifacts/
/fuzz/coverage/
# Ignore generated corpus noise; keep committed seeds under parser/ addable
# without `git add -f` (cannot re-include under an ignored parent directory).
/fuzz/corpus/*
!/fuzz/corpus/parser/
!/fuzz/corpus/parser/**

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# Kiro settings (local, not committed)
/.kiro/settings/cli.json
/.kiro/settings/lsp.json

# Local agent tooling worktrees (not committed)
/.claude/

# Bisection harness compiled binary
/tools/bisection/bisect
/tools/bisection/train-diff
/tools/bisection/nbest-train-diff
/tools/bisection/live-typing-diff
/tools/bisection/import-diff
/tools/bisection/frontend-import
/tools/bisection/scheme-diff
/tools/bisection/chewing-diff
/tools/bisection/user-candidate-diff
/tools/bisection/addon-candidate-diff
/tools/bisection/predict-diff
/tools/bisection/punct-diff
/tools/bisection/union-diff
/tools/bisection/union-edge-diff
/tools/bisection/plant-oracle-bigram

# macOS
.DS_Store

# The user-learning store is per-user runtime data; it must never be
# committed (W6-T5: no user-data fixtures beyond tiny synthetic ones).
user_store.redb
tools/bisection/fullpin-diff
/tools/bisection/uncovered-surface-diff
/tools/bisection/pred-order-diff

# Python development (crates/oxpinyin-python)
.venv*/
__pycache__/
*.py[cod]

# maturin editable-install artifacts land the extension next to python-source
/crates/oxpinyin-python/python/oxpinyin/*.so
/crates/oxpinyin-python/python/oxpinyin/*.pyd

# LMDB creates a runtime lock file beside each committed .lmdb fixture.
/fixtures/w3/*.lmdb-lock

# Container drop-in gates write their cargo targets here (run-dropin-*.sh).
/target-fedora/
/target-debian/
/target-nixos/
