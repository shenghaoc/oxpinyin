# Reproducible build of the pin-built oracle's LIBRARIES (issue #818).
#
# Stage `deps` is the pin-reference build environment: Debian stable by
# codename, debian:trixie, from the default mirrors with normal security
# updates. A move to the next Debian release is a deliberate codename change,
# never automatic. Tools/oracle/version-manifest.json names every component
# that affects reference results; versions.py records the installed versions
# and fails the build, naming the component, when one is outside its range.
# Stage `build` runs tools/oracle/build-oracle.sh --libs-only once per DBM
# backend at fixed in-image paths. The final stage is the published image:
# libpinyin.so, libzhuyin.so, headers, pkg-config files, oracle-pin.txt per
# backend and the recorded tool versions. It carries NO model20-derived data
# (that is not redistributable: docs/findings/model-provenance.md); a lane
# regenerates lib/libpinyin/data locally with `build-oracle.sh --regen-data`
# (docs/runbooks/oracle.md).
#
# The build context is the repository root:
#   docker build -f tools/oracle/Dockerfile.oracle -t oxpinyin-oracle .

# Every stage follows ORACLE_PLATFORM. It defaults to linux/amd64, so the
# amd64 build command is unchanged; arm64 callers pass
# --build-arg ORACLE_PLATFORM=linux/arm64. The frozen hashes are selected per
# platform; the build and run commands pass --platform as well.
ARG ORACLE_PLATFORM=linux/amd64

FROM --platform=$ORACLE_PLATFORM debian:trixie AS deps

# Behind a TLS-intercepting egress proxy (a cloud session: tools/cloud/setup.sh)
# the proxy arrives as the predefined build arg https_proxy and its CA as the
# optional BuildKit secret `cacert`; apt trusts that CA for any https source.
# The base image keeps its default Debian mirrors, so the packages and the
# toolchain are the same with or without the proxy.
COPY tools/oracle/version-manifest.json /usr/local/share/oxpinyin/version-manifest.json
COPY tools/oracle/versions.py /usr/local/bin/versions.py
COPY tools/tkrzw/distro-probe.sh /usr/local/bin/distro-probe.sh
RUN --mount=type=secret,id=cacert,required=false,mode=0444 \
    set -eu; set --; \
    if [ -s /run/secrets/cacert ]; then \
        set -- -o Acquire::https::CaInfo=/run/secrets/cacert; \
    fi; \
    apt-get "$@" update; \
    apt-get "$@" install -y --no-install-recommends \
        build-essential \
        autoconf automake autopoint libtool \
        pkg-config gettext gnome-common \
        curl ca-certificates git tar patch python3 \
        libglib2.0-dev \
        libsqlite3-dev \
        libdb-dev \
        libkyotocabinet-dev \
        libtkrzw-dev \
        tkrzw-utils; \
    rm -rf /var/lib/apt/lists/*; \
    python3 /usr/local/bin/versions.py \
        --manifest /usr/local/share/oxpinyin/version-manifest.json \
        --probe /usr/local/bin/distro-probe.sh \
        --record /opt/oracle-versions.txt

FROM deps AS build

COPY tools/oracle/build-oracle.sh /usr/local/bin/build-oracle.sh
RUN set -eu; \
    for dbm in bdb kc tkrzw; do \
        build-oracle.sh --libs-only --enable-libzhuyin --dbm "$dbm" \
            --work-dir "/build/$dbm" --prefix "/opt/pinyin-oracle/$dbm" \
            --jobs "$(nproc)"; \
        rm -rf "/build/$dbm"; \
    done

FROM --platform=$ORACLE_PLATFORM scratch
COPY --from=build /opt/pinyin-oracle /opt/pinyin-oracle
COPY --from=build /opt/oracle-versions.txt /opt/pinyin-oracle/versions.txt

