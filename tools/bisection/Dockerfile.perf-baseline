# Reproducible Stage-2 performance-baseline environment.
#
# Builds both oracle (libpinyin-2.11.91 + Tkrzw) and oxpinyin-capi
# (Kyoto Cabinet backend) in a single image. Run the benchmark with:
#
#   docker build --platform linux/arm64 -f tools/bisection/Dockerfile.perf-baseline -t oxpinyin-perf .
#   docker run --rm -v /tmp/perf-out:/out oxpinyin-perf
#
# The container writes JSONL captures and markdown reports to /out.

FROM --platform=linux/arm64 debian:testing@sha256:dab11cdb0a9dcf4bbd68f671635b35f1f726b452b92396875b69bb2c7daa42a9

RUN rm -f /etc/apt/sources.list.d/debian.sources /etc/apt/sources.list \
    && echo 'deb http://snapshot.debian.org/archive/debian/20260831T000000Z testing main' \
    > /etc/apt/sources.list

RUN apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends \
    build-essential \
    autoconf automake autopoint libtool \
    pkg-config gettext gnome-common \
    curl ca-certificates \
    tar \
    python3 \
    libglib2.0-dev \
    libtkrzw-dev \
    libkyotocabinet-dev \
    libsqlite3-dev sqlite3 \
    libclang-dev \
    libssl-dev \
    libibus-1.0-dev \
    util-linux \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSfL \
    "https://static.rust-lang.org/rustup/archive/1.29.0/aarch64-unknown-linux-gnu/rustup-init" \
    -o /tmp/rustup-init \
    && echo "9732d6c5e2a098d3521fca8145d826ae0aaa067ef2385ead08e6feac88fa5792  /tmp/rustup-init" \
    | sha256sum -c - \
    && chmod +x /tmp/rustup-init \
    && /tmp/rustup-init -y --default-toolchain 1.97.1 --profile minimal \
    --component clippy,rustfmt \
    && rm /tmp/rustup-init
ENV PATH="/root/.cargo/bin:${PATH}"

RUN cargo install cargo-c@0.10.25 --locked

COPY . /repo
WORKDIR /repo

RUN bash tools/oracle/build-oracle.sh \
    --prefix /opt/pinyin-oracle \
    --jobs "$(nproc)"

RUN bash tools/model/fetch-model.sh

RUN cargo run --locked --release -p oxpinyin-datagen -- compile \
    --model-dir target/model20/extracted \
    --out-dir /tmp/oxpinyin-export

ENV PINYIN_ORACLE_PREFIX=/opt/pinyin-oracle
ENV PINYIN_EXPORT_DIR=/tmp/oxpinyin-export
ENV PERF_CPU=0
ENV PERF_RUNS=20
ENV PERF_CYCLES=8
ENV PERF_RAM_RUNS=10
ENV OXPINYIN_PERF_WORK=/out

CMD ["bash", "tools/bisection/run-perf-baseline.sh"]
