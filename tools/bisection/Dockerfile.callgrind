# Instruction-level differential environment for the steady keystroke cycle.
#
# Builds the Tkrzw cell pair only — libpinyin at the oracle pin and
# oxpinyin — plus valgrind and the instrumented bisect harness, so one
# harness binary can be run under callgrind against each `.so` in turn.
# Because bisect.c drives both engines through the same C ABI, the same
# harness against each library gives directly comparable totals.
#
#   docker build -f tools/bisection/Dockerfile.callgrind -t oxpinyin-callgrind .
# Run with the verified-runtime mount and exact library environment in
# docs/runbooks/cloud.md (Runtime enforcement); the runtime guard is shell and
# needs no uv, while the measurement entry point is Python (installed below).
# The packaged libtkrzw alone does not establish a trusted runtime.
#
# Never build or run this emulated: a platform differing from the host
# profiles the interpreter, not the implementations. No --platform here.
#
# ── How this differs from Dockerfile.perf-matrix, and why ────────────
#
# 1. valgrind is installed. It is the only instrument available on a host
#    with no PMU: this recipe's own target hosts include an Apple-silicon
#    container, where hardware counters do not exist, and a Firecracker
#    microVM, where perf_event_open answers ENOENT.
# 2. `strip --strip-all` is NOT run. Stripping removes .symtab, and
#    without it callgrind has no symbol to attribute Ir to — the
#    differential would be one unnamed blob. This is the one change the
#    profile cannot be taken without.
# 3. oxpinyin is built with debug info for line-level attribution, via
#    CARGO_PROFILE_RELEASE_DEBUG and NOT via RUSTFLAGS="-Cdebuginfo=1".
#    RUSTFLAGS alone is silently useless here: cargo passes
#    -Cstrip=debuginfo whenever the *profile* asks for no debug info, so
#    the flag emits DWARF and cargo strips it right back out — verified
#    on rustc 1.97.1, where the RUSTFLAGS-only build carries zero
#    .debug_* sections. libpinyin needs no counterpart: autotools'
#    default CFLAGS are already `-g -O2`.
#
#    Debug info is NOT free of side effects on the artifact, and the
#    differential run measures that rather than assuming it away. The
#    profile's debug level feeds cargo's crate metadata hash, which feeds
#    every mangled symbol name, which feeds link order: the debug build's
#    .text has the same size and the same instruction multiset as the
#    stock one but different bytes, because ~1,700 functions land at
#    different addresses. Instruction counts are unaffected by that;
#    simulated cache and branch figures are not. Stage 2 of
#    the callgrind-differential recipe separates the two cases.
# 4. The datagen step is dropped. This is the drop-in configuration
#    the perf-same-data recipe measures: both cells open libpinyin's own
#    installed data directory, so there is no oxpinyin-generated data to
#    compile.
#
# Everything else — base image tag, default mirrors, oracle pin, configure
# flags, cargo flags, release profile — is Dockerfile.perf-matrix verbatim.

# Multi-arch OCI index (amd64, arm64, …): resolves to the build host's
# native variant. Do not pin --platform here.
#
# Rolling Debian testing from the default mirrors, deliberately unpinned (no
# digest, no snapshot). BASE_IMAGE names the base; an override is the same
# rolling tag, not a different image identity. The versions it used are
# printed at build time; there is no range check because testing rolls.
ARG BASE_IMAGE=debian:testing
FROM ${BASE_IMAGE}

COPY tools/oracle/version-manifest.json /usr/local/share/oxpinyin/version-manifest.json
COPY tools/oracle/versions.py /usr/local/bin/versions.py

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    build-essential \
    autoconf automake autopoint libtool \
    pkg-config gettext gnome-common \
    curl ca-certificates \
    git \
    tar \
    python3 \
    libglib2.0-dev \
    libtkrzw-dev \
    liblzma-dev \
    liblz4-dev \
    libzstd-dev \
    zlib1g-dev \
    libsqlite3-dev sqlite3 \
    libclang-dev \
    libssl-dev \
    libibus-1.0-dev \
    util-linux \
    valgrind \
    binutils \
    && rm -rf /var/lib/apt/lists/* \
    && python3 /usr/local/bin/versions.py \
       --print --manifest /usr/local/share/oxpinyin/version-manifest.json

# rustup-init is per-arch: take the build host's own binary and verify it
# against the pinned checksum for that arch
# (static.rust-lang.org/rustup/archive/1.29.0/<arch>/rustup-init.sha256).
# Exact on purpose (#1074): rustup-init installs from a checksum, and a checksum
# is only known for a known version; the stable toolchain's output depends on its
# version (keep it equal to the channel in rust-toolchain.toml).
RUN set -eu; \
    case "$(uname -m)" in \
        x86_64)  rustup_arch=x86_64-unknown-linux-gnu; \
                 rustup_sha=4acc9acc76d5079515b46346a485974457b5a79893cfb01112423c89aeb5aa10 ;; \
        aarch64) rustup_arch=aarch64-unknown-linux-gnu; \
                 rustup_sha=9732d6c5e2a098d3521fca8145d826ae0aaa067ef2385ead08e6feac88fa5792 ;; \
        *) echo "unsupported build arch: $(uname -m)" >&2; exit 1 ;; \
    esac; \
    curl --proto '=https' --tlsv1.2 -sSfL \
        "https://static.rust-lang.org/rustup/archive/1.29.0/$rustup_arch/rustup-init" \
        -o /tmp/rustup-init \
    && echo "$rustup_sha  /tmp/rustup-init" \
    | sha256sum -c - \
    && chmod +x /tmp/rustup-init \
    && /tmp/rustup-init -y --default-toolchain 1.97.1 --profile minimal \
       --component clippy,rustfmt \
    && rm /tmp/rustup-init
ENV PATH="/root/.cargo/bin:${PATH}"

# Cargo parallelism, capped for small build VMs. This image's target hosts
# include a Docker Desktop VM with its default ~8 GiB, where nproc-wide
# jobs during the fat-LTO / codegen-units=1 link stages can exhaust memory
# before any single job fails cleanly. Modest default; raise per host:
#   docker build --build-arg cargo_jobs=8 -f tools/bisection/Dockerfile.callgrind .
ARG cargo_jobs=4
ENV CARGO_BUILD_JOBS=${cargo_jobs}

# Exact on purpose (#1074): a fresh image, and cargo-c's rust-version rises with
# each release (0.10.24 needs Rust 1.95, 0.10.26 needs 1.97), so an unpinned
# install would break once it passes the pinned Rust. Any cargo-c at or above
# the minimum that `just doctor` reports builds the same objects
# (docs/packaging.md, "Regeneration").
RUN cargo install cargo-c@0.10.25 --locked

# uv 0.13.1 and the managed interpreter that .python-version names: the entry point
# below is `python -m tools.dev measure ...`. The file and the install script are copied
# in because the build has no checkout as its working directory yet; the version is not
# restated here. uv 0.13.1 has no +gil archive, so tools/install-python.sh installs the
# file's request without +gil. The libtkrzw runtime check stays the shell resolver
# (tools/tkrzw/runtime.py); installing uv does not establish trust in a runtime.
COPY .python-version /opt/python-pin/.python-version
COPY tools/install-python.sh /opt/python-pin/tools/install-python.sh
COPY tools/lib/bash-floor.sh /opt/python-pin/tools/lib/bash-floor.sh
# Archive digest: https://github.com/astral-sh/uv/releases/download/0.13.1/sha256.sum.
# Exact on purpose (#1074): this image installs from a checksum, and a checksum
# is only known for a known version.
ENV UV_INSTALL_DIR=/opt/uv/bin UV_PYTHON_INSTALL_DIR=/opt/uv/python UV_CACHE_DIR=/opt/uv/cache
RUN set -eu; \
    [ "$(uname -s)" = Linux ]; \
    case $(uname -m) in \
      x86_64) uv_target=x86_64-unknown-linux-gnu; \
              uv_sha256=eadd9d27c134ab5ac1ffd4473b97a741407f3ea238288f03121fc4deddf90220 ;; \
      aarch64 | arm64) uv_target=aarch64-unknown-linux-gnu; \
              uv_sha256=9041c73c99fdc5892cf128140beb354eca9231d502068cc36e6cb53a8e59ad14 ;; \
      *) printf 'no uv target for architecture %s\n' "$(uname -m)" >&2; exit 1 ;; \
    esac; \
    uv_payload=$(curl --fail --location --retry 3 "https://github.com/astral-sh/uv/releases/download/0.13.1/uv-$uv_target.tar.gz" | base64); \
    uv_actual=$(printf '%s' "$uv_payload" | base64 -d | sha256sum); \
    [ "${uv_actual%% *}" = "$uv_sha256" ] || { printf 'uv archive checksum mismatch\n' >&2; exit 1; }; \
    uv_tmp=$(mktemp -d); \
    trap 'rm -rf "$uv_tmp"' EXIT; \
    trap 'exit 1' HUP INT TERM; \
    printf '%s' "$uv_payload" | base64 -d | tar -xz -C "$uv_tmp" "uv-$uv_target/uv" "uv-$uv_target/uvx"; \
    mkdir -p /opt/uv/bin; \
    install -m755 "$uv_tmp/uv-$uv_target/uv" "$uv_tmp/uv-$uv_target/uvx" /opt/uv/bin/; \
    unset uv_payload; \
    export PATH="/opt/uv/bin:$PATH"; \
    /opt/uv/bin/uv --version | grep -q '^uv 0\.13\.1 '; \
    /opt/python-pin/tools/install-python.sh; \
    cd /opt/python-pin; \
    /opt/uv/bin/uv run --no-project --managed-python python -X lazy_imports=normal \
      -c 'from pathlib import Path; import subprocess, sys, sysconfig; assert sys.implementation.name == "cpython"; assert sys.version_info.releaselevel == "final" and (3, 15, 0) <= sys.version_info[:3] < (3, 16, 0); assert sysconfig.get_config_var("Py_GIL_DISABLED") == 0; assert sys._is_gil_enabled(); managed = subprocess.check_output(["uv", "python", "find", "--managed-python"], text=True).strip(); assert Path(sys.executable).resolve() == Path(managed).resolve()'
ENV PATH=/opt/uv/bin:$PATH

COPY . /repo
WORKDIR /repo

# ── Shared: model data + libpinyin source ────────────────────────────

RUN bash tools/model/fetch-model.sh

# libpinyin source: git fetch pinned by commit SHA. Mirrors
# tools/oracle/build-oracle.sh and Dockerfile.perf-matrix.
RUN git init --quiet /tmp/libpinyin-src \
    && git -C /tmp/libpinyin-src fetch --quiet --depth=1 \
       https://github.com/libpinyin/libpinyin.git \
       074a2219c90feaf962d0d24f034514033ece5f99 \
    && [ "$(git -C /tmp/libpinyin-src rev-parse FETCH_HEAD)" = \
       "074a2219c90feaf962d0d24f034514033ece5f99" ] \
    && git -C /tmp/libpinyin-src checkout --quiet --detach FETCH_HEAD

# ── libpinyin + Tkrzw (the oracle) ──────────────────────────────────
# Not stripped: callgrind needs .symtab to name anything.

RUN cp -a /tmp/libpinyin-src /tmp/build-A-src \
    && cp target/model20/extracted/* /tmp/build-A-src/data/ \
    && mkdir /tmp/build-A && mv /tmp/build-A-src /tmp/build-A/libpinyin-src \
    && cd /tmp/build-A/libpinyin-src \
    && autoreconf --force --install \
    && ./configure --prefix=/opt/libpinyin-tkrzw --disable-static --with-dbm=Tkrzw \
    && make -j"$(nproc)" && make install \
    && rm -rf /tmp/build-A

# ── oxpinyin + Tkrzw ────────────────────────────────────────────────
# Same flags as the matrix recipe plus -Cdebuginfo=1. Not stripped.

RUN CARGO_PROFILE_RELEASE_DEBUG=1 cargo cinstall --locked --release -p oxpinyin-capi \
    --no-default-features --features tkrzw \
    --destdir=/opt/oxpinyin-tkrzw/stage --prefix=/usr \
    --manifest-path /repo/Cargo.toml

# ── debug-info neutrality control ───────────────────────────────────
# The same crate built with debug info off, kept so the differential run
# can compare the two .text sections and classify any difference:
# identical bytes, or identical instruction multiset at different
# addresses, or genuinely different codegen (which stops the run).

RUN cargo cinstall --locked --release -p oxpinyin-capi \
    --no-default-features --features tkrzw \
    --destdir=/opt/oxpinyin-nodebug/stage --prefix=/usr \
    --manifest-path /repo/Cargo.toml

# ── Allocation-counter build (non-default feature) ──────────────────
# Auxiliary artifact only: exports oxpinyin_alloc_count/_bytes, which the
# harness reads through dlsym. Never the artifact the Ir differential
# profiles, and never shipped.

RUN CARGO_PROFILE_RELEASE_DEBUG=1 cargo cinstall --locked --release -p oxpinyin-capi \
    --no-default-features --features tkrzw,alloc-count \
    --destdir=/opt/oxpinyin-alloccount/stage --prefix=/usr \
    --manifest-path /repo/Cargo.toml

# ── The instrumented bisect harness ─────────────────────────────────
# -g for line attribution. Carries bisect_perf_cold_unit /
# bisect_perf_steady_unit, the callgrind collection anchors.

RUN gcc -std=gnu11 -Wall -Wextra -Werror -O2 -g \
    -o /repo/tools/bisection/bisect \
    /repo/tools/bisection/bisect.c -ldl

# The two anchors must be distinct, externally visible symbols: if the
# compiler folded them (they have identical bodies) the toggle would also
# collect the cold cycle. Fail the build rather than mismeasure.
RUN set -eu; \
    cold=$(nm /repo/tools/bisection/bisect | awk '$3=="bisect_perf_cold_unit"{print $1}'); \
    steady=$(nm /repo/tools/bisection/bisect | awk '$3=="bisect_perf_steady_unit"{print $1}'); \
    [ -n "$cold" ] && [ -n "$steady" ] || { echo "fatal: collection anchors missing from symtab" >&2; exit 1; }; \
    [ "$cold" != "$steady" ] || { echo "fatal: collection anchors folded to one address ($cold)" >&2; exit 1; }; \
    echo "anchors ok: cold=$cold steady=$steady"

ENV PERF_CPU=0
ENV CG_OUT=/out

CMD ["uv", "run", "--no-project", "--managed-python", "python", "-X", "lazy_imports=normal", \
     "-m", "tools.dev", "measure", "callgrind-differential"]
